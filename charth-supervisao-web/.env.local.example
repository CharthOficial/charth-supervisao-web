# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto no console do Firebase (Configurações do projeto > Geral > Seus apps).
# NÃO envie .env.local para o GitHub — ele já deve estar no .gitignore.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Acesso pelo Hub (login único por token) ---
# Endereço do Hub como o NAVEGADOR alcança, sem barra no fim. Ex.: http://10.20.10.4:8091
NEXT_PUBLIC_HUB_URL=
# A MESMA chave que o Hub usa para assinar os tokens: variável HUB_SSO_SECRET do Hub ou o
# conteúdo do arquivo sso.key (no servidor: /home/suporte/docker/hub-data/sso.key). Só servidor.
HUB_SSO_SECRET=
# Número (id) deste app na lista de sistemas do Hub. O token só vale para este id.
HUB_PORTAL_ID=
# JSON inteiro da chave de conta de serviço do Firebase (uma chave NOVA, exclusiva
# para este servidor), colado em uma linha. Nunca vai para o repositório.
FIREBASE_SERVICE_ACCOUNT=
