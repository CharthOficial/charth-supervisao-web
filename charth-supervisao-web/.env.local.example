# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto no console do Firebase (Configurações do projeto > Geral > Seus apps).
# NÃO envie .env.local para o GitHub — ele já deve estar no .gitignore.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
